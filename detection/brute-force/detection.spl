# Windows Brute-Force Detection
# SOC L1 | Splunk | Windows Security Event Logs
#
# Detect repeated failed authentication attempts
# against the same user from the same source IP.
#
# Event ID: 4625
# Threshold: 10+ failures within 5 minutes

index=* signature_id=4625
| bin _time span=5m
| stats count as failed_attempts by _time, user, src_ip
| where failed_attempts >= 10
| sort - failed_attempts
